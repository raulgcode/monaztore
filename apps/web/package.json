    "@monaztore/contracts": "workspace:*",
    "@monaztore/core": "workspace:*",
    "@monaztore/db": "workspace:*",
    "@monaztore/email": "workspace:*",
    "@monaztore/env": "workspace:*",
    "@monaztore/hacienda": "workspace:*",
    "@monaztore/i18n": "workspace:*",
    "@monaztore/storage": "workspace:*",
    "@react-router/node": "catalog:",
    "@react-router/serve": "catalog:",
    "@simplewebauthn/browser": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "isbot": "catalog:",
