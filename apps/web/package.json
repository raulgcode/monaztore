{
  "name": "@monaztore/web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "NODE_ENV=development react-router typegen && tsc",
    "lighthouse": "lhci autorun && pnpm lighthouse:dark && pnpm lighthouse:es",
    "lighthouse:dark": "lhci autorun --collect.settings.extraHeaders='{\"Cookie\":\"theme=ImRhcmsi\"}'",
    "lighthouse:es": "lhci autorun --collect.settings.extraHeaders='{\"Accept-Language\":\"es\"}'"
  },
  "dependencies": {
    "@conform-to/react": "catalog:",
